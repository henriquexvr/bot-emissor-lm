# Copie este arquivo para `.env` e preencha com os seus dados.
# `.env` não deve ser versionado.

# ==== Google Sheets ====
# ID e GID da planilha com as cargas (veja a seção "Planilha" no README)
GOOGLE_SHEETS_ID=COLE_O_ID_DA_PLANILHA_AQUI
GOOGLE_SHEETS_GID=COLE_O_GID_DA_ABA_AQUI

# ==== Transportadora ====
# CNPJ e nome da transportadora (exibido no CTRC)
TRANSPORTADORA=00.000.000/0000-00 - NOME DA TRANSPORTADORA

# ==== Status usados na planilha ====
STATUS_ORIGEM=EM_PROCESSAMENTO
STATUS_FINAL=CARGA_FINALIZADA
STATUS_VEICULO_SEM_PLACA=VEICULO_SEM_PLACA
STATUS_MOTORISTA_NAO_CADASTRADO=MOTORISTA_NAO_CADASTRADO
STATUS_PLACA_REJEITADA=PLACA_REJEITADA
STATUS_PLACA_NAO_CADASTRADA=PLACA_NAO_CADASTRADA
STATUS_DADOS_INCOMPLETOS=DADOS_INCOMPLETOS

# ==== Emissão ====
# Emite averbação junto com o CTRC (true/false)
EMITIR_AVERBACAO=true

# ==== Navegador ====
# Caminho do perfil persistente do Chrome (mantém login no portal)
# Se vazio, usa chrome_bot_profile na raiz do projeto
CHROME_USER_DATA=

# ==== Execução ====
MODO_EXECUCAO=desenvolvimento
NUM_WORKERS=2

# ==== Parâmetros avançados (opcional) ====
PASSADA_1_BLOCO_TAMANHO=10
PASSADA_2_MAX_TENTATIVAS_PLAY=2
PASSADA_2_MAX_TENTATIVAS_FILA=10
LOOP_INTERVALO_MS=10000